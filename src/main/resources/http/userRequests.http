### POST register
POST {{url}}/api/auth/register
Content-Type: application/json
#Authorization: Bearer {{authToken}}


{
  "email": "ex@tv.com",
  "password": "1234"
}

### POST login (run this first - captures token for all other requests)
POST {{url}}/api/auth/login
Content-Type: application/json

{
 "email": "{{newAdminEmail}}",
  "password": "{{newAdminPassword}}"

}

> {% client.global.set("authToken", response.body.token); %}

### POST register the future admin (run after logging in as an existing admin)
POST {{url}}/api/auth/register
Content-Type: application/json

{
  "email": "{{newAdminEmail}}",
  "password": "{{newAdminPassword}}"
}

> {% client.global.set("newAdminUserId", response.body.id); %}

### PUT grant the ADMIN role to the newly registered user
PUT {{baseUrl}}/9/admin
Authorization: Bearer {{authToken}}

> {%
  client.test("New user has the ADMIN role", function() {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.roles.includes("ADMIN"), "ADMIN role was not assigned");
  });
%}

###POST
POST {{url}}/api/email/send
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "to": "emilxavierthorsen@gmail.com",
  "subject": "Test",
  "body": "It works",
  "html": false
}

### GET all users
GET {{baseUrl}}/all
Accept: application/json
Authorization: Bearer {{authToken}}

### GET user by ID
GET {{baseUrl}}/1
Accept: application/json
Authorization: Bearer {{authToken}}

### POST create user
POST {{baseUrl}}/
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "tenantId": 1,
  "firstName": "Daniel",
  "lastName": "User",
  "zipCode": 12345,
  "email": "http.user@example.com",
  "password": "secret",
  "phoneNumber": "555-0100",
  "messageIds": [1, 2]
}

### PUT update user
PUT {{baseUrl}}/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "tenantId": 1,
  "firstName": "HTTP",
  "lastName": "User Updated",
  "zipCode": 54321,
  "email": "http.user.updated@example.com",
  "password": "newsecret",
  "phoneNumber": "555-0101",
  "messageIds": [1]
}

### DELETE user
DELETE {{baseUrl}}/1
Authorization: Bearer {{authToken}}
